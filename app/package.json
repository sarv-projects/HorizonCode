{
  "name": "hzcode-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "src/",
    "schema/",
    "kernel.sha256"
  ],
  "bin": {
    "hzcode": "../bin/hzcode"
  },
  "scripts": {
    "start": "bun --no-env-file run src/main.ts",
    "eval": "bun --no-env-file run src/eval-run.ts",
    "batch": "bun --no-env-file run src/batch-run.ts",
    "stats": "bun --no-env-file run src/session-stats.ts",
    "grow": "bun --no-env-file run src/grow.ts",
    "typecheck": "bunx tsc --noEmit -p .",
    "test": "bun test --timeout 30000",
    "check": "bunx tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
