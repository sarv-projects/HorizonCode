# OS junk
.DS_Store
Thumbs.db

# Editors
*.swp
.idea/
.vscode/

# Build outputs (once implementation begins)
node_modules/
dist/
target/
*.tsbuildinfo

# Local runtime state — a workspace's own log/state is never committed
.hz/state/
.hzcode/

# Local secrets (provider keys, etc.)
.env
.env.local

# Reference clones of studied projects live OUTSIDE the repo (repo-tour/).
# Guard against accidental copies inside the worktree (a 1.5G move-in happened once).
repo-tour/
