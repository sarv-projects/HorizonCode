# OS junk
.DS_Store
Thumbs.db

# Editors
*.swp
.idea/
.vscode/

# Build outputs (once implementation begins)
node_modules/
dist/
target/
*.tsbuildinfo

# Local runtime state — a workspace's own log/state is never committed
.hz/
.hzcode/

# Stray Bun test-runner binary produced by a mis-invoked runner
/bun:test

# PowerShell transcripts / scripts captured during debugging
*.ps

# Local verification logs and scratch toolchain artifacts (never commit)
.scratch/

# Local secrets (provider keys, etc.)
.env
.env.local

# Reference clones of studied projects live OUTSIDE the repo (repo-tour/).
# Guard against accidental copies inside the worktree (a 1.5G move-in happened once).
repo-tour/

# Competitive steal/learn clones + notes (never commit)
repo_take/

# Local runtime config, code-intelligence cache, and Playwright MCP state
app/.config/
.code-intelligence/
.playwright-mcp/
